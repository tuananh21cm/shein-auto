# Copy file này thành .env rồi điền. KHÔNG commit .env.
# Máy mới chỉ BẮT BUỘC nhóm 1 + 2; các nhóm sau thiếu thì tính năng đó tắt, server vẫn chạy.

# ── 1. Đường dẫn (mỗi máy mỗi khác) ──────────────────────
DOWNLOAD_DIR=C:/Users/<ten-may>/Downloads
BASE_SHEINAUTO_DIR=C:/Users/<ten-may>/Downloads/SheinAuto
HUB_DIR=                       # folder Hub dùng chung cả đội (để trống = Hub riêng máy này)

# ── 2. AI đặt title + map category (pipeline listing chết nếu thiếu) ──
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_LISTING_MODEL=          # để trống = Haiku 4.5 (mặc định)

# ── 3. Host ảnh mô tả (Cloudflare R2) — thiếu thì listing không có ảnh mô tả ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=                # vd https://img.<domain>.com

# ── 4. Admin UI ──────────────────────────────────────────
ADMIN_PORT=3000
ADMIN_SESSION_SECRET=          # chuỗi ngẫu nhiên dài, mỗi máy một cái

# ── 5. Tự đăng nhập 4Seller (giải captcha) — thiếu thì phải kéo cookie tay ──
CAPSOLVER_API_KEY=
COOKIE_REFRESH_CRON=           # mặc định */20 * * * *
DISABLE_COOKIE_AUTO_REFRESH=   # =1 để tắt hẳn

# ── 6. CRM KBT (màn Vận hành: sức khoẻ shop, lãi lỗ SKU) ──
# Dùng cái này HOẶC config/crm.json (cùng nội dung, config/crm.json ưu tiên thấp hơn).
CRM_BRIDGE_ENABLED=            # =1 để bật
CRM_BRIDGE_URL=
CRM_BRIDGE_SECRET=

# ── 7. Thông báo Telegram (để trống = tắt) ────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 8. Tuỳ chọn khác ─────────────────────────────────────
CRON_FILE_ROUTER=              # override config/worker.json
CRON_QUEUE_MANAGER=
VIDEO_RENDER_URL=              # server render video trong LAN
VIDEO_API_KEY=
DISABLE_VIDEO_STUDIO_CRON=
TUNNEL_DOMAIN=                 # Cloudflare Tunnel (màn Domain)
KIKI_API=                      # Kiki (profile browser + captcha)
RAPIDAPI_KEY=                  # tra cứu SHEIN qua RapidAPI
SHEIN_API_V1_ENABLED=
SHEIN_API_V1_DETAIL_PATH=
DISABLE_DASH_WARM=             # =1 tắt warm cache dashboard lúc khởi động
DRYRUN_HOLD_MIN=
DEBUG_SPECIFICS=
GEMINI_API_KEY=                # cũ: pipeline listing đã chuyển sang Claude, chỉ còn hiện ở Settings

