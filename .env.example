# Gemini API key — bắt buộc cho AI title & category mapping
GEMINI_API_KEY=

# Đường dẫn nguồn (Chrome auto-download Shein JSON về đây)
DOWNLOAD_DIR=C:/Users/KBT/Downloads

# Đường dẫn folder trung tâm chứa các shop (P5-001, P5-002, ...)
BASE_SHEINAUTO_DIR=C:/Users/KBT/Downloads/SheinAuto

# Cron biểu thức — override config/worker.json nếu set
CRON_FILE_ROUTER=
CRON_QUEUE_MANAGER=

# Admin UI
ADMIN_PORT=3000
ADMIN_SESSION_SECRET=

# Telegram notification (để trống = tắt notification)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daily report — kênh Telegram RIÊNG nhận report tổng hợp hằng ngày (để trống = tắt)
# Bot mặc định dùng chung TELEGRAM_BOT_TOKEN; set DAILY_REPORT_TG_BOT_TOKEN nếu muốn bot khác.
DAILY_REPORT_TG_CHAT_ID=
DAILY_REPORT_TG_BOT_TOKEN=
# Lịch gửi (mặc định 8:00 sáng giờ VN)
DAILY_REPORT_CRON=0 8 * * *
